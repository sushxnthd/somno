# Copy this file to .env and fill in your Supabase project's values to enable real
# accounts/sync. Without these set, Somno runs entirely on local on-device storage —
# every feature works, it just won't sync across devices or survive an uninstall.
#
# Get these from your Supabase project: Project Settings -> API
#   EXPO_PUBLIC_SUPABASE_URL      -> "Project URL"
#   EXPO_PUBLIC_SUPABASE_ANON_KEY -> "anon" / "public" key (NOT the service_role key)
#
# After setting these, apply supabase/schema.sql to your project (SQL editor, or
# `supabase db push` if you're using the Supabase CLI) before signing up in-app.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Google sign-in
# ---------------------------------------------------------------------------
# From Google Cloud Console -> APIs & Services -> Credentials. Both are needed, and they are
# different things: the platform client identifies the app to Google, while Supabase validates the
# ID token's audience against the WEB client — leaving the web one blank makes every Google
# sign-in fail with an audience mismatch, even on a phone.
#
# Neither value is a secret; both ship inside the app binary. The Google client SECRET (web client
# only) is not used by the app at all — it goes into Supabase: Authentication -> Providers ->
# Google, together with the same web client ID.
#
# The iOS client ID's reversed form is also hard-coded as `iosUrlScheme` in app.json, because a
# config plugin cannot read .env. If you change the iOS client ID, change it there too.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=300611786949-9qehonm8bv8bevnebbvgrdgjik06em86.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Android additionally needs its own OAuth client (type: Android) registered in Google Cloud with
# package name com.somno.app and the SHA-1 of the signing key EAS uses. No value is set here for
# it — Google matches the app by package + signature, not by an ID in the app.
